{
  // Панель Source Control показывает то, что в работе, а не инвентарь клонов.
  //
  // Механика (проверено по исходнику расширения git, 04.08): обход воркспейса
  // читает каталоги до repositoryScanMaxDepth, отсекая по ИМЕНИ каталога всё, что
  // перечислено в repositoryScanIgnoredFolders; .gitignore при этом не читается —
  // ignored-путь детекту не помеха. Поэтому:
  //
  //   .repos       исключён по имени: это отражение стержневых веток, источник, и
  //                полсотни клонов в панели вытесняли из неё всё остальное
  //                (scm.repositories.visible по умолчанию 10).
  //   .repos-wip   обходится: деревья лежат на глубине 2 и подхватываются сами,
  //                без единой строки здесь. Заводится worktree — появляется в
  //                панели; сносится — исчезает.
  //
  // scanRepositories ниже — исключения из первого правила: клоны, куда коммиты
  // идут напрямую, мимо тикетных веток и worktree. Список ведётся по факту, а не
  // на всякий случай: строка здесь стоит ровно столько же, сколько строка в любом
  // другом ручном реестре. Glob не поддерживается (path.join, не minimatch),
  // абсолютные пути игнорируются с предупреждением.
  "git.autoRepositoryDetection": true,
  "git.repositoryScanMaxDepth": 3,
  "git.repositoryScanIgnoredFolders": [
    "node_modules",
    ".repos"
  ],
  // Пусто намеренно. Обход сам находит vault и деревья в .repos-wip/; явные
  // записи здесь их вытесняли из панели. Клон, куда понадобится коммитить
  // напрямую, добавляется сюда временно и убирается по окончании.
  "git.scanRepositories": []
}
